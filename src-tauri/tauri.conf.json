{
  "package": {
    "productName": "PDF Sanitizer",
    "version": "1.0.0"
  },
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devPath": "http://localhost:5173",
    "distDir": "src-tauri/tauri-dist"
  },
  "tauri": {
    "allowlist": {
      "shell": {
        "open": true
      },
      "dialog": {
        "open": true
      }
    },
    "bundle": {
      "identifier": "com.pdfsanitizer.app"
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "PDF Sanitizer",
        "width": 1200
      }
    ],
    "security": {
      "csp": null
    }
  }
}
