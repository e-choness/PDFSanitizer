{
  "productName": "PDF Sanitizer",
  "version": "1.0.0",
  "build": {
    "before-dev-command": "pnpm dev",
    "before-build-command": "pnpm build",
    "dev-path": "http://localhost:5173",
    "dist-dir": "../dist"
  },
  "tauri": {
    "bundle": {
      "identifier": "com.pdfsanitizer.app"
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "PDF Sanitizer",
        "width": 1200
      }
    ],
    "security": {
      "csp": null
    }
  }
}
